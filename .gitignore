# Dependencies and build output
node_modules/
dist/
coverage/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
client_secret*.json

# Runtime dashboard data and installed themes
.dashboard/
data/
installed-themes/
*.local.json

# Local tooling and operating-system files
.local/
.vite/
*.log
.DS_Store
Thumbs.db
.agents
.codex/
.codex-tmp/

# End-to-end run artifacts. `screenshots/` is kept out of Playwright's
# `test-results/`, which Playwright wipes at the start of every run.
screenshots/
.e2e-workspace*/
.dry-run/
test-results/
playwright-report/

# Active agent MCP test run output — the driver and fixtures are source,
# but each run's evidence (logs, screenshots, final-state JSON) is not.
active-agent-trials/trials/

# Agent skills, installed per-machine
.claude/skills/

# Editor and agent-tool local configuration
.vscode/

# Playwright
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
