{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./components/*"],
      "@/components/*": ["./components/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "registry", "tests", "e2e", "playwright.config.ts"],
  // Fixture component source destined for a seeded workspace, not this repo's
  // own tree — it imports "./schemas.generated" and "./schema", which only
  // exist once copied next to a workspace's own registry/.
  "exclude": ["e2e/fixtures"]
}
