{
  "name": "agentic-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "registry:build": "tsx scripts/registry-schemas.ts && npx --yes shadcn@latest build",
    "typecheck": "tsx scripts/registry-schemas.ts && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "skills:install": "npx --yes skills@latest experimental_install",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.md\" \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.md\" \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.23.12",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
